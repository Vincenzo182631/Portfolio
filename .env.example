# Build-time (Cloudflare Pages > Settings > Environment variables, and a local .env)
SITE_URL=https://your-domain.com
# Only "true" lets search engines index the build. Leave unset on preview/staging.
ALLOW_INDEXING=false
# Optional, cookieless analytics. Leave empty to ship no tracking script.
PUBLIC_CF_BEACON_TOKEN=
PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: Cloudflare Turnstile site key (public) for the contact form
PUBLIC_TURNSTILE_SITE_KEY=

# Runtime secrets for functions/api/contact.ts (Cloudflare Pages > Settings > Variables and Secrets).
# Never commit real values. For local `wrangler pages dev`, put them in .dev.vars
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
TURNSTILE_SECRET_KEY=
