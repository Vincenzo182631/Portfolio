---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faqs from '../../components/Faqs.astro';
import Arrow from '../../components/Arrow.astro';
import { services, serviceBySlug } from '../../data/services';
import { breadcrumbSchema, serviceSchema } from '../../data/schema';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const trail = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }, { name: s.short, path: `/services/${s.slug}/` }];
const work = await getCollection('work');
const projects = s.projects.map((id) => work.find((w) => w.id === id)).filter((w) => !!w);
const related = s.related.map((slug) => serviceBySlug(slug)!);
const inquiryHref = `/contact/?service=${encodeURIComponent(s.inquiry.value)}`;
---
<BaseLayout
  title={s.metaTitle}
  description={s.description}
  jsonLd={[breadcrumbSchema(Astro.site!, trail), serviceSchema(Astro.site!, s)]}
  close={{ heading: s.inquiry.heading, line: s.inquiry.line, service: s.inquiry.value }}
>
  <div class="doc-block"><div class="wrap">
    <Crumbs trail={trail} />
    <header class="doc-head">
      <h1>{s.h1}</h1>
      <p class="t-lead">{s.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={inquiryHref} data-track={`cta-service-${s.slug}`}>{profile.mainAction}<Arrow /></a>
        <a class="btn btn--secondary" href={inquiryHref} data-track={`cta-review-${s.slug}`}>{s.inquiry.label}</a>
      </div>
    </header>
  </div></div>

  <div class="doc-block"><div class="wrap">
    <div class="grid grid--top">
      <h2 class="doc-h2 span-5">Who this service helps</h2>
      <ul class="plain-list span-6 start-7">{s.who.map((w) => <li>{w}</li>)}</ul>
    </div>
  </div></div>

  <div class="doc-block doc-block--surface"><div class="wrap">
    <h2>Problems this solves</h2>
    <div class="block-list">
      {s.problems.map((p) => <div><h3>{p.title}</h3><p>{p.text}</p></div>)}
    </div>
  </div></div>

  <div class="doc-block"><div class="wrap">
    <h2>My technical approach</h2>
    <ol class="numbered">
      {s.approach.map((a) => <li><div><h3>{a.title}</h3><p class="measure">{a.text}</p></div></li>)}
    </ol>
  </div></div>

  {s.flow && (
    <div class="doc-block doc-block--surface"><div class="wrap">
      <h2>{s.flow.heading}</h2>
      <p class="t-lead measure" style="margin-bottom: var(--s-6)">{s.flow.intro}</p>
      <ol class="flow-h" style={`--n: ${s.flow.steps.length}`}>
        {s.flow.steps.map((st) => <li><b>{st.label}</b><span>{st.detail}</span></li>)}
      </ol>
    </div></div>
  )}

  {s.deepDives?.map((d, i) => (
    <div class:list={['doc-block', { 'doc-block--surface': i % 2 === 0 }]} id={d.id}><div class="wrap">
      <div class="grid grid--top">
        <div class="span-5 stack-4">
          <h2 class="doc-h2" style="margin-bottom: 0">{d.heading}</h2>
          <p class="t-lead">{d.intro}</p>
          {d.note && <p class="note">{d.note}</p>}
        </div>
        <ul class="plain-list span-6 start-7">{d.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div></div>
  ))}

  <div class="doc-block"><div class="wrap">
    <div class="grid grid--top">
      <div class="span-6">
        <h2 class="doc-h2">Capabilities</h2>
        <ul class="tags">{s.capabilities.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="span-5 start-8">
        <h2 class="doc-h2">Example deliverables</h2>
        <ul class="plain-list">{s.deliverables.map((d) => <li>{d}</li>)}</ul>
      </div>
    </div>
  </div></div>

  <div class="doc-block doc-block--surface"><div class="wrap">
    <h2>Related projects</h2>
    <div class="grid">
      {projects.map((w) => (
        <a class="post-card span-4" href={`/work/${w.id}/`} style="background: var(--bg)">
          <p class="meta"><span>{w.data.client}</span><span>{w.data.status}</span></p>
          <h3>{w.data.title}</h3>
          <p>{w.data.summary}</p>
          <span class="link">Read the case study</span>
        </a>
      ))}
    </div>
  </div></div>

  <div class="doc-block"><div class="wrap">
    <div class="grid grid--top">
      <div class="span-4 stack-4">
        <h2 class="doc-h2" style="margin-bottom: 0">Questions about {['GoHighLevel', 'Technical SEO'].includes(s.short) ? s.short : s.short.toLowerCase()}</h2>
        <p class="muted">Something else to ask?</p>
        <p><a class="link" href={inquiryHref}>Send me your question</a></p>
      </div>
      <div class="span-7 start-6"><Faqs items={s.faqs} /></div>
    </div>
  </div></div>

  <div class="doc-block"><div class="wrap">
    <h2>Related services</h2>
    <ul class="rows rows--svc">
      {related.map((r) => <li><a class="rows__name" href={`/services/${r.slug}/`}>{r.name}</a><p>{r.homeLine}</p></li>)}
    </ul>
  </div></div>
</BaseLayout>
