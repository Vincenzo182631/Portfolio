---
import { mainNav, serviceNav } from '../data/navigation';
import { profile } from '../data/profile';
import Arrow from './Arrow.astro';
const path = Astro.url.pathname;
const isHome = path === '/';
const current = (href: string) => (!isHome && path.startsWith(href) ? 'page' : undefined);
---
<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/"><span class="mark mark--initial" aria-hidden="true">V</span>{profile.name}</a>
    <nav class="nav__links" aria-label="Main">
      {mainNav.map((item) => item.label === 'Services' ? (
        <div class="nav__item">
          <a class="nav__link" href={item.href} aria-current={current(item.href)}>{item.label} <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="nav__menu">
            <div class="wrap grid">
              <div class="menu-col span-4">
                <p class="t-label">Search</p>
                <a href={serviceNav[0].href}>{serviceNav[0].label}<span>{serviceNav[0].line}</span></a>
                <a href={serviceNav[1].href}>{serviceNav[1].label}<span>{serviceNav[1].line}</span></a>
              </div>
              <div class="menu-col span-4">
                <p class="t-label">Systems</p>
                <a href={serviceNav[2].href}>{serviceNav[2].label}<span>{serviceNav[2].line}</span></a>
                <a href={serviceNav[3].href}>{serviceNav[3].label}<span>{serviceNav[3].line}</span></a>
              </div>
              <div class="menu-col span-4">
                <p class="t-label">Overview</p>
                <a href="/services/">All services<span>What I do and how the parts connect</span></a>
                <a href="/work/">Selected work<span>Hospitality, travel, events, education</span></a>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="nav__item"><a class="nav__link" href={item.href} aria-current={current(item.href)}>{item.label}</a></div>
      ))}
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="/contact/" data-track="cta-nav">{profile.mainAction}<Arrow /></a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
